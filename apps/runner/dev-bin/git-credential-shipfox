#!/bin/sh
# Git resolves the credential helper by name, and only a runner image links the built one onto
# PATH. `pnpm dev` puts this directory on PATH so a source-run runner finds the helper too.
runner_dir="$(cd "$(dirname "$0")/.." && pwd)"
exec "$runner_dir/node_modules/.bin/tsx" --conditions=workspace-source \
  "$runner_dir/src/git-credential-helper.ts" "$@"
