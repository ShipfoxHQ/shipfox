{
  "name": "@shipfox/actions",
  "license": "MIT",
  "private": false,
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShipfoxHQ/shipfox.git",
    "directory": "libs/shared/workflow/actions"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "imports": {
    "#test/*": "./test/*",
    "#*": {
      "workspace-source": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "workspace-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./contract": {
      "workspace-source": {
        "types": "./src/contract.ts",
        "default": "./src/contract.ts"
      },
      "default": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      }
    },
    "./download-writer": {
      "workspace-source": {
        "types": "./src/download-writer.ts",
        "default": "./src/download-writer.ts"
      },
      "default": {
        "types": "./dist/download-writer.d.ts",
        "default": "./dist/download-writer.js"
      }
    },
    "./runtime-files": {
      "workspace-source": {
        "types": "./src/runtime-files.ts",
        "default": "./src/runtime-files.ts"
      },
      "default": {
        "types": "./dist/runtime-files.d.ts",
        "default": "./dist/runtime-files.js"
      }
    },
    "./tool-grants": {
      "workspace-source": {
        "types": "./src/generated/tool-grants.ts",
        "default": "./src/generated/tool-grants.ts"
      },
      "default": {
        "types": "./dist/generated/tool-grants.d.ts",
        "default": "./dist/generated/tool-grants.js"
      }
    },
    "./testing": {
      "workspace-source": {
        "types": "./src/testing/index.ts",
        "default": "./src/testing/index.ts"
      },
      "default": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "scripts": {
    "build": "shipfox-swc",
    "check": "shipfox-biome-check",
    "check:fix": "shipfox-biome-check --write",
    "depcruise": "shipfox-depcruise",
    "test": "shipfox-vitest-run",
    "test:watch": "shipfox-vitest-watch",
    "type": "shipfox-tsc-check",
    "type:emit": "shipfox-tsc-emit"
  },
  "dependencies": {
    "@shipfox/expression": "workspace:*",
    "@shipfox/workflow-document": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@shipfox/biome": "workspace:*",
    "@shipfox/depcruise": "workspace:*",
    "@shipfox/swc": "workspace:*",
    "@shipfox/ts-config": "workspace:*",
    "@shipfox/typescript": "workspace:*",
    "@shipfox/vitest": "workspace:*"
  }
}
