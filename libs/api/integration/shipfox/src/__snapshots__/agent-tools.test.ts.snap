                "type": "string",
              },
              "job_id": {
                "format": "uuid",
                "type": "string",
              },
              "step_attempt_id": {
                "format": "uuid",
                "type": "string",
              },
              "step_id": {
                "format": "uuid",
                "type": "string",
              },
              "total_lines": {
                "minimum": 0,
                "type": "integer",
              },
