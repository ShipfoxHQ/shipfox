[
  {
    "description": "Start another synced workflow that has a manual trigger and return its run identity. The call does not wait for the child run to finish.",
    "id": "start_workflow_run",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "description": "Idempotency key for agent calls.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "inputs": {
          "description": "Trigger inputs as a JSON object, limited to 16384 UTF-8 bytes when serialized.",
          "type": "object",
        },
        "project_id": {
          "description": "Project UUID that owns the workflow. Defaults to the calling run project.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "type": "string",
        },
        "workflow": {
          "description": "Synced workflow configuration path, such as .shipfox/workflows/deploy.yml",
          "maxLength": 1024,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "workflow",
      ],
      "type": "object",
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "deduplicated": {
          "type": "boolean",
        },
        "name": {
          "type": "string",
        },
        "project_id": {
          "description": "Project UUID that owns the workflow.",
          "type": "string",
        },
        "run_id": {
          "description": "Started workflow run UUID.",
          "type": "string",
        },
        "run_number": {
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [
        "run_id",
        "run_number",
        "name",
        "project_id",
        "deduplicated",
      ],
      "type": "object",
    },
    "requiredScope": [],
    "sensitive": false,
    "sensitivity": "write",
  },
