{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["mise.toml", "biome.json", "compose.yml"],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "LINEAR_*",
    "CLICKUP_*",
    "POSTHOG_*",
    "ACTIONS_*",
    "AGENT_SESSION_*",
    "LOG_*",
    "USAGE_*",
    "OBJECT_STORAGE_*",
    "E2E_*",
    "API_URL",
    "API_PUBLIC_URL",
    "CLIENT_URL",
    "ARGOS_TOKEN",
    "SHIPFOX_VITEST_MAX_WORKERS",
    "CI",
    "CLOUDFLARE_PAGES_COMMIT_SHA"
  ],
  "tasks": {
    "build": {
      "cache": true,
      "outputs": ["dist/**/*", "!dist/**/*.d.ts", "!dist/**/*.d.ts.map", "storybook-output/**/*"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "API_PORT",
        "BROWSER",
        "BROWSER_ARGS",
        "CLIENT_BASE_URL",
        "DEFINITION_*",
        "GITEA_BASE_URL",
        "HOST",
        "CLICKUP_API_BASE_URL",
        "CLICKUP_AUTH_BASE_URL",
        "CLICKUP_OAUTH_CLIENT_ID",
        "CLICKUP_OAUTH_CLIENT_SECRET",
        "CLICKUP_OAUTH_REDIRECT_URL",
        "CLICKUP_WEBHOOK_BASE_URL",
        "POSTHOG_API_BASE_URL",
        "POSTHOG_MCP_ENDPOINT",
        "NOTION_API_BASE_URL",
        "NOTION_OAUTH_CLIENT_ID",
        "NOTION_OAUTH_CLIENT_SECRET",
        "NOTION_OAUTH_REDIRECT_URL",
        "NOTION_WEBHOOK_VERIFICATION_TOKEN",
        "INTEGRATIONS_ENABLE_CLICKUP_PROVIDER",
        "INTEGRATIONS_ENABLE_NOTION_PROVIDER",
        "INTEGRATIONS_ENABLE_SLACK_PROVIDER",
        "OBJECT_STORAGE_S3_ENDPOINT",
        "OTEL_*",
        "POSTGRES_*",
        "SHIPFOX_*",
        "SLACK_API_BASE_URL",
        "SLACK_OAUTH_CLIENT_ID",
        "SLACK_OAUTH_CLIENT_SECRET",
        "SLACK_OAUTH_REDIRECT_URL",
        "SLACK_SIGNING_SECRET",
        "TEMPORAL_*",
        "USAGE_*",
        "VITE_*"
      ]
    },
    "check": {
      "cache": true,
      "dependsOn": ["@shipfox/biome#build"]
    },
    "type": {
      "cache": true,
      "dependsOn": ["@shipfox/typescript#build", "^type:emit"]
    },
    "type:emit": {
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.stories.ts",
        "!**/*.stories.tsx",
        "!test/**",
        "!tsconfig.test.json",
        "!vitest.config.ts"
      ],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"],
      "dependsOn": ["@shipfox/typescript#build", "type", "^type:emit"]
    },
    "test": {
      "cache": true,
      "passThroughEnv": [
        "CLIENT_BASE_URL",
        "GITEA_BASE_URL",
        "OBJECT_STORAGE_S3_ENDPOINT",
        "OTEL_*",
        "POSTGRES_*",
        "SHIPFOX_*",
        "TEMPORAL_*",
        "USAGE_*",
        "VITE_API_URL"
      ],
      "dependsOn": ["^build", "build"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": [
        "CLIENT_BASE_URL",
        "GITEA_BASE_URL",
        "OBJECT_STORAGE_S3_ENDPOINT",
        "OTEL_*",
        "POSTGRES_*",
        "SHIPFOX_*",
        "TEMPORAL_*",
        "USAGE_*",
        "VITE_API_URL"
      ],
      "dependsOn": ["^build", "build"]
    },
    "test:external": {
      "cache": false,
      "dependsOn": ["^build", "build", "^type:emit", "type:emit"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "ADMIN_BOOTSTRAP_TOKEN",
        "CLIENT_BASE_URL",
        "CLICKUP_API_BASE_URL",
        "NOTION_API_BASE_URL",
        "NOTION_WEBHOOK_VERIFICATION_TOKEN",
        "POSTHOG_API_BASE_URL",
        "POSTHOG_MCP_ENDPOINT",
        "SLACK_API_BASE_URL",
        "SLACK_SIGNING_SECRET"
      ]
    },
    "storybook:build": {
      "cache": true,
      "outputs": ["storybook-static/**/*"],
      "dependsOn": ["^build"]
    },
    "depcruise": {
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.dependency-cruiser.cjs",
        "$TURBO_ROOT$/api-contexts.cjs"
      ],
      "dependsOn": ["@shipfox/depcruise#build"]
    },
    "verify": {
      "cache": true,
      "dependsOn": ["build"]
    },
    "image": {
      "cache": false,
      "dependsOn": ["build", "@shipfox/worktree-services#build"],
      "env": ["BUILD_NUMBER", "NODE_VERSION", "PNPM_VERSION", "RUNNER_VERSION"],
      "passThroughEnv": ["IMAGE_REGISTRIES"]
    }
  }
}
