{
  "name": "@shipfox/runner-base",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#*": "./src/*"
  },
  "bin": {
    "build-runner-base": "./bin/build-runner-base.js",
    "plan-runner-base": "./bin/plan-runner-base.js",
    "publish-runner-base": "./bin/publish-runner-base.js",
    "runner-base-recipe": "./bin/runner-base-recipe.js"
  },
  "scripts": {
    "build": "shipfox-swc",
    "check": "shipfox-biome-check",
    "check:fix": "shipfox-biome-check --write",
    "image:build": "node ./bin/build-runner-base.js",
    "test": "shipfox-vitest-run",
    "type": "shipfox-tsc-check",
    "type:emit": "shipfox-tsc-emit",
    "verify": "node scripts/verify-packer.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "catalog:",
    "@aws-sdk/client-kms": "catalog:",
    "@aws-sdk/client-ssm": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:"
  },
  "devDependencies": {
    "@shipfox/biome": "workspace:*",
    "@shipfox/swc": "workspace:*",
    "@shipfox/tool-utils": "workspace:*",
    "@shipfox/ts-config": "workspace:*",
    "@shipfox/typescript": "workspace:*",
    "@shipfox/vitest": "workspace:*"
  }
}
